# ═══════════════════════════════════════════════════════════
# Phantom SIFT — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── LLM Provider (pick ONE) ──────────────────────────────
# Options: "workers-ai" (FREE), "anthropic" ($$), "openai" (compatible)
LLM_PROVIDER=workers-ai

# ─── Option A: Cloudflare Workers AI (FREE — 10K neurons/day) ───
# Default model: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# Get token: https://dash.cloudflare.com → AI → Workers AI → API Token
# Get account ID: `npx wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_WORKERS_AI_TOKEN=your_workers_ai_token
AGENT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ─── Option B: Anthropic Claude (best reasoning, expensive) ─────
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# AGENT_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER=anthropic

# ─── Option C: OpenAI-compatible (Groq FREE, Together, Ollama) ──
# OPENAI_API_KEY=gsk_xxxxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AGENT_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=openai
#
# For local Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AGENT_MODEL=llama3.1:70b
# LLM_PROVIDER=openai

# ─── Cloudflare AI Gateway (optional — logging + caching) ───────
# Works with ANY provider above. Provides automatic:
# - Token usage logging (satisfies hackathon req #8)
# - Response caching (saves $)
# - Rate limiting
# Create at: https://dash.cloudflare.com → AI → AI Gateway → Create
CLOUDFLARE_AI_GATEWAY_ID=phantom-sift

# ─── Remote MCP Server on Cloudflare Workers (optional) ─────────
# Deploy with: cd src/remote_mcp && npx wrangler deploy
REMOTE_MCP_URL=https://phantom-sift-mcp.your-subdomain.workers.dev

# ─── Threat Intelligence (optional — enriches findings) ─────────
VIRUSTOTAL_API_KEY=your_vt_key
ABUSEIPDB_API_KEY=your_abuseipdb_key

# ─── Agent Configuration ────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
AGENT_TEMPERATURE=0.1

# ─── Evidence Configuration ─────────────────────────────────────
EVIDENCE_MOUNT_PATH=/mnt/evidence
EVIDENCE_READ_ONLY=true

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
EXECUTION_LOG_PATH=./logs/execution.jsonl

# ═══════════════════════════════════════════════════════════
# Quick Setup (copy-paste):
#
# FREE (Workers AI):
#   npx wrangler login
#   npx wrangler whoami  → copy Account ID
#   Dashboard → AI → Workers AI → Create API Token
#
# FREE (Groq):
#   https://console.groq.com → API Keys → Create
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_xxxxx
#   AGENT_MODEL=llama-3.3-70b-versatile
# ═══════════════════════════════════════════════════════════
